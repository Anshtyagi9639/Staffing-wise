# Copy to .env.local for local development. Never commit real values.
# Every variable is optional for local development; see docs/deployment.md for production.

# --- Site -------------------------------------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.staffingwise.ie
# Only "production" is indexable. Leave unset (or "staging") on previews/staging: noindex + robots Disallow.
NEXT_PUBLIC_SITE_ENV=

# --- Enquiry delivery (server only; at least one channel is required in production) ------------------------
# Email via Resend (https://resend.com). The sending domain must be verified in Resend.
EMAIL_API_KEY=
EMAIL_FROM="Staffing Wise Website <website@staffingwise.ie>"
ENQUIRY_TO_EMAIL=info@staffingwise.ie
# Optional: post each enquiry as JSON to a CRM / automation webhook (HTTPS). Secret is sent as a Bearer token.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# --- Analytics and marketing (public IDs; each tool stays off while its value is empty) ---------------------
# Use EITHER a GTM container (recommended; GA4/Ads/LinkedIn configured inside GTM) OR the direct IDs below.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_ENQUIRY_LABEL=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_ENQUIRY_CONVERSION_ID=

# --- Search engine verification (meta tag method) ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
